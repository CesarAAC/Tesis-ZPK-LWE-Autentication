# Puertos expuestos en el host
API_PORT=8010
POSTGRES_HOST_PORT=5437

# Base de datos local de desarrollo
POSTGRES_DB=lwe_auth_db
POSTGRES_USER=lwe_user
POSTGRES_PASSWORD=change_me_for_local_development
DATABASE_URL=postgresql://lwe_user:change_me_for_local_development@db:5432/lwe_auth_db

# Benchmarking
# Las ejecuciones oficiales reciben commit/image/host automáticamente desde scripts/benchmark.sh.
# ALLOW_DIRTY_BENCHMARK=1 permite ejecutar deliberadamente sobre un working tree sucio.
ALLOW_DIRTY_BENCHMARK=0

# Optional: pin official benchmark containers to specific host CPUs, e.g. 2 or 2-3.
# Leave empty unless the same policy is used for every compared protocol.
BENCHMARK_CPUSET=
